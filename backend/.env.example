# ─── Backend Environment Variables ───────────────────────────────
# Copy this file to .env and fill in your values

# MongoDB Atlas connection string
MONGODB_URI=mongodb+srv://YOUR_USERNAME:YOUR_PASSWORD@cluster0.xxxxx.mongodb.net/bustracker?retryWrites=true&w=majority

# JWT Secret — use a long random string in production
JWT_SECRET=change_this_to_a_very_long_random_secret_key_in_production

# Your Render frontend URL (set after deploying frontend)
FRONTEND_URL=https://your-frontend-name.onrender.com

# Server port (Render sets this automatically, keep as 5000 for local)
PORT=5000

NODE_ENV=production
